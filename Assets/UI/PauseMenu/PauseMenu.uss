.results-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    width: 100%;
    height: 100%;
    background-color: #111111;
    color: white;
    font-size: 18px;
}

.title {
    font-size: 32px;
    -unity-font-style: bold;
    margin-bottom: 30px;
}

.stats {
    display: flex;
    flex-direction: column;
    margin-bottom: 40px;
}

.stat {
    font-size: 20px;
    margin-top: 10px;
    margin-bottom: 10px;
}

.action-button {
    background-color: yellow;
    border-color: black;
    border-width: 2px;
    border-radius: 8px;
    color: black;
    font-size: 20px;
    width: 160px;
    height: 50px;
}

.button-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px; /* 按钮之间的间距 */
    margin-top: 20px;
}
