.root {
    flex-direction: row;
    width: 100%;
    height: 100%;
    background-color: black;
}

.left-panel {
    width: 70%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.right-panel {
    width: 100%;
    height: 100%;
    overflow: auto;
    padding: 10px;
    background-color: transparent;
}

.song-item {
    height: 60px;
    margin-bottom: 10px;
    background-color: #515151;
    border-color: #FFC400;
    border-radius: 8px;
    border-width: 2px;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

.action-button {
    background-color: yellow;
    border-color: black;
    border-width: 2px;
    border-radius: 8px;
    color: black;
    font-size: 20px;
    width: 160px;
    height: 50px;
}


.right-container {
  flex-direction: column;    /* 垂直排列内部 */
  width: 30%;
  height: 100%;
}